Configs: {
	MassReforgeServerConfig: {
		DisplayName: 批量重铸设置
		Headers.Reforging: 重铸券

		IgnoreCalamityHorriblePrefix: {
			Label: 重铸券忽略骇人词条
			Tooltip: 重铸券的词条列表与“最高级”默认排除灾厄的骇人词条；关闭后恢复为候选。仅影响重铸券，未加载灾厄时无影响。联机以服务端设置为准。
		}

		PreferRuthlessForSummonWeapons: {
			Label: 非鞭子召唤武器最高级优先无情
			Tooltip: “最高级”为召唤武器优先选择“无情”词条；无法应用无情或关闭时按物品价值选择最高的合法词条。联机以服务端设置为准。
		}
	}
}

Items: {
	WeaponReforgeScroll: {
		DisplayName: 武器重铸券
		Tooltip:
			'''
			选择一个前缀，一键重铸背包与快捷栏内的全部武器与工具（不含弹药与鼠标上的物品）
			选择“最高级”会为每把武器自动选择应用后价值最高的合法前缀
			默认让鞭子以外的召唤武器优先获得“无情”词条，可在设置中关闭
			至少成功修改一件武器才消耗一张，不额外收取金币
			'''
	}

	AccessoryReforgeScroll: {
		DisplayName: 饰品重铸券
		Tooltip:
			'''
			选择一个前缀，一键重铸背包、全部配装、外观与模组饰品槽内的饰品
			不适用的饰品和已有所选前缀的饰品保持原样
			至少成功修改一件饰品才消耗一张，不额外收取金币
			'''
	}
}

UI: {
	WeaponReforge: {
		Title: 武器批量重铸
		Hint: 包含背包与快捷栏的武器、工具
		SelectPrefix: 请选择目标前缀或“最高级”
		Highest: 最高级
		HighestHint: 逐把武器选择应用后物品价值最高的合法前缀；同价值优先保留当前词条。
		Counts: 预计修改 {0} 件 · 原已符合 {1} 件 · 不适用 {2} 件
		Confirm: 一键重铸
		Refresh: 刷新列表
		Cancel: 取消
		Empty: 当前没有可重铸的武器或工具
		StorageError: 无法读取武器存储，操作已停止
		Unavailable: 当前无法执行，请等待使用动作结束后重试
		NoScroll: 背包或鼠标上没有武器重铸券
		NoChanges: 没有成功修改武器，未消耗重铸券
		Success: 已修改 {0} 件武器，原已符合 {1} 件，跳过 {2} 件；消耗一张武器重铸券
	}

	AccessoryReforge: {
		Title: 饰品批量重铸
		Hint: 包含背包、全部配装、外观与模组饰品槽
		SelectPrefix: 请选择目标饰品前缀
		Counts: 预计修改 {0} 件 · 已符合 {1} 件 · 不适用 {2} 件
		Confirm: 一键重铸
		Refresh: 刷新列表
		Cancel: 取消
		Empty: 当前没有可重铸的饰品
		StorageError: 无法读取全部模组饰品槽，操作已停止
		Unavailable: 当前无法执行，请等待使用动作结束后重试
		NoScroll: 背包或鼠标上没有饰品重铸券
		NoChanges: 没有成功修改饰品，未消耗重铸券
		Success: 已修改 {0} 件饰品，原已符合 {1} 件，跳过 {2} 件；消耗一张重铸券
	}
}
