Configs: {
	MassReforgeServerConfig: {
		DisplayName: 批量重铸设置
		Headers.Reforging: 重铸券

		IgnoreCalamityHorriblePrefix: {
			Label: 重铸券忽略骇人词条
			Tooltip: 重铸券不选用灾厄的骇人词条。
		}

		PreferRuthlessForSummonWeapons: {
			Label: 非鞭子召唤武器最高级优先无情
			Tooltip: “最高级”为鞭子以外的召唤武器优先选择“无情”。
		}

		WeaponScrollPricePlatinum: {
			Label: 武器重铸券价格（铂金币）
			Tooltip: 调整武器重铸券售价。
		}

		AccessoryScrollPricePlatinum: {
			Label: 饰品重铸券价格（铂金币）
			Tooltip: 调整饰品重铸券售价。
		}
	}
}

Items: {
	WeaponReforgeScroll: {
		DisplayName: 武器重铸券
		Tooltip:
			'''
			选择一个前缀，一键重铸背包与快捷栏的武器和工具（不含弹药与鼠标物品）
			“最高级”为每把武器选择应用后价值最高的合法前缀
			非鞭子召唤武器默认优先选择“无情”
			至少修改一件才消耗一张，不额外收取金币
			'''
	}

	AccessoryReforgeScroll: {
		DisplayName: 饰品重铸券
		Tooltip:
			'''
			选择一个前缀，一键重铸背包、全部配装、外观与模组饰品槽中的饰品
			至少修改一件才消耗一张，不额外收取金币
			'''
	}
}

UI: {
	WeaponReforge: {
		Title: 武器批量重铸
		Hint: 背包与快捷栏的武器和工具
		SelectPrefix: 选择目标前缀或“最高级”
		Highest: 最高级
		HighestHint: 逐把选择价值最高的合法前缀；非鞭子召唤武器默认优先“无情”。
		Counts: 预计修改 {0} · 已符合 {1} · 不适用 {2}
		Confirm: 一键重铸
		Refresh: 刷新列表
		Cancel: 取消
		Empty: 当前没有可重铸的武器或工具
		StorageError: 无法读取武器存储，操作已停止
		Unavailable: 请等待物品使用动作结束后重试
		NoScroll: 背包或鼠标上没有武器重铸券
		NoChanges: 没有成功修改武器，未消耗重铸券
		Success: 已修改 {0} 件武器，原符合 {1} 件，跳过 {2} 件；消耗一张武器重铸券
	}

	AccessoryReforge: {
		Title: 饰品批量重铸
		Hint: 背包、全部配装、外观与模组饰品槽
		SelectPrefix: 选择目标饰品前缀
		Counts: 预计修改 {0} · 已符合 {1} · 不适用 {2}
		Confirm: 一键重铸
		Refresh: 刷新列表
		Cancel: 取消
		Empty: 当前没有可重铸的饰品
		StorageError: 无法读取全部模组饰品槽，操作已停止
		Unavailable: 请等待物品使用动作结束后重试
		NoScroll: 背包或鼠标上没有饰品重铸券
		NoChanges: 没有成功修改饰品，未消耗重铸券
		Success: 已修改 {0} 件饰品，原符合 {1} 件，跳过 {2} 件；消耗一张饰品重铸券
	}
}
