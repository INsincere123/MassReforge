Configs: {
	MassReforgeServerConfig: {
		DisplayName: MassReforge Settings
		Headers.Reforging: Reforge Scrolls

		IgnoreCalamityHorriblePrefix: {
			Label: Skip Calamity's Horrible modifier
			Tooltip: Excludes Calamity's Horrible modifier from scroll choices. Enabled by default.
		}

		PreferRuthlessForSummonWeapons: {
			Label: Prefer Ruthless for non-whip summon weapons
			Tooltip: Best Available prefers Ruthless for non-whip summon weapons. Enabled by default.
		}

		WeaponScrollPricePlatinum: {
			Label: Weapon Reforge Scroll price (platinum)
			Tooltip: Sets what the Goblin Tinkerer charges for Weapon Reforge Scrolls.
		}

		AccessoryScrollPricePlatinum: {
			Label: Accessory Reforge Scroll price (platinum)
			Tooltip: Sets what the Goblin Tinkerer charges for Accessory Reforge Scrolls.
		}
	}
}

Items: {
	WeaponReforgeScroll: {
		DisplayName: Weapon Reforge Scroll
		Tooltip:
			'''
			Use it directly. Choose a modifier and reforge all eligible weapons and tools in your inventory and hotbar (excludes ammo and the item on your cursor)
			Best Available selects the modifier with the highest resulting item value; non-whip summon weapons prefer Ruthless by default
			Consumes one scroll only if at least one weapon changes, at no additional cost
			'''
	}

	AccessoryReforgeScroll: {
		DisplayName: Accessory Reforge Scroll
		Tooltip:
			'''
			Use it directly. Choose a modifier and reforge all eligible accessories across your inventory, loadouts, vanity slots, and modded accessory slots
			Consumes one scroll only if at least one accessory changes, at no additional cost
			'''
	}
}

UI: {
	WeaponReforge: {
		Title: Reforge Weapons
		Hint: Weapons and tools in your inventory and hotbar
		SelectPrefix: Pick a modifier or Best Available
		Highest: Best Available
		HighestHint: Selects the modifier with the highest resulting item value. Ties favor the current modifier. Non-whip summon weapons prefer Ruthless by default.
		Counts: Changes: {0} · Matching: {1} · Skipped: {2}
		Confirm: Reforge All
		Refresh: Refresh
		Cancel: Cancel
		Empty: No weapons or tools can be reforged right now
		StorageError: Couldn't read your weapon storage, so nothing was changed
		Unavailable: Wait for your item use animation to finish, then try again
		NoScroll: No Weapon Reforge Scroll in your inventory or on your cursor
		NoChanges: Nothing changed, so no scroll was consumed
		Success: Reforged {0} weapons. {1} already matched, {2} skipped. Consumed one Weapon Reforge Scroll.
	}

	AccessoryReforge: {
		Title: Reforge Accessories
		Hint: Accessories across your inventory, loadouts, vanity slots, and modded slots
		SelectPrefix: Pick an accessory modifier
		Counts: Changes: {0} · Matching: {1} · Skipped: {2}
		Confirm: Reforge All
		Refresh: Refresh
		Cancel: Cancel
		Empty: No accessories can be reforged right now
		StorageError: Couldn't read all your accessory slots, so nothing was changed
		Unavailable: Wait for your item use animation to finish, then try again
		NoScroll: No Accessory Reforge Scroll in your inventory or on your cursor
		NoChanges: Nothing changed, so no scroll was consumed
		Success: Reforged {0} accessories. {1} already matched, {2} skipped. Consumed one Accessory Reforge Scroll.
	}
}
